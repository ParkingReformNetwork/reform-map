{
  "name": "mandates-map",
  "version": "0.1.0",
  "source": "index.html",
  "type": "module",
  "scripts": {
    "start": "parcel",
    "build": "rm -rf dist .parcel-cache; parcel build --detailed-report",
    "test": "npm run gen-html-sample -- --quiet; playwright test",
    "check": "tsc --noEmit",
    "fmt": "biome check --write .",
    "fix": "biome check --write --unsafe .",
    "lint": "biome ci .",
    "gen-data-set": "tsx scripts/generateDataSet.ts",
    "gen-html": "tsx node_modules/@11ty/eleventy/cmd.cjs --config=eleventy.config.ts",
    "gen-html-sample": "GEN_HTML_SAMPLE=true tsx node_modules/@11ty/eleventy/cmd.cjs --config=eleventy.config.ts",
    "gen-redirects": "tsx scripts/generateRedirects.ts",
    "sync-directus": "tsx scripts/syncDirectus.ts",
    "broken-links": "tsx scripts/brokenLinks.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "serve-dist": "cd dist; http-server",
    "test-dist": "PORT=8080 playwright test tests/app"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@biomejs/biome": "^2.5.2",
    "@directus/sdk": "^18.0.3",
    "@parcel/compressor-brotli": "^2.16.4",
    "@parcel/compressor-gzip": "^2.16.4",
    "@parcel/transformer-sass": "^2.16.4",
    "@playwright/test": "^1.61.1",
    "@types/fs-extra": "^11.0.4",
    "@types/leaflet": "^1.9.15",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.20.0",
    "@types/node-fetch": "^2.6.12",
    "@types/node-geocoder": "^4.2.6",
    "@types/papaparse": "^5.3.15",
    "@types/tabulator-tables": "^6.2.3",
    "clean-css": "^5.3.3",
    "happy-dom": "^20.8.9",
    "http-server": "^14.1.1",
    "node-fetch": "^3.3.2",
    "node-geocoder": "^4.4.1",
    "papaparse": "^5.4.1",
    "parcel": "^2.16.4",
    "playwright": "^1.56.1",
    "sass": "^1.83.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "zx": "^8.8.5"
  },
  "targets": {
    "default": {
      "publicUrl": "./"
    }
  },
  "dependencies": {
    "choices.js": "^10.2.0",
    "leaflet": "^1.9.4",
    "lodash-es": "^4.17.21",
    "tabulator-tables": "^6.3.0"
  }
}
